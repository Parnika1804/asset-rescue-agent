# Copy this file to .env and fill in your values.
# Never commit .env to Git — it is already in .gitignore.

# ── Azure AI Foundry / OpenAI ────────────────────────────────────────────────
AZURE_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_FOUNDRY_KEY=your-foundry-api-key-here
AZURE_CHAT_DEPLOYMENT=gpt-4o
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Azure AI Search ──────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-key-here
AZURE_SEARCH_INDEX=asset-policy-index

# ── App settings ─────────────────────────────────────────────────────────────
DB_PATH=data/assets.db
DATA_PATH=data/assets.csv
